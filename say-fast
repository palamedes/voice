#!/usr/bin/env bash
# say-fast — speak the given text out loud with the fast, non-cloned Kokoro voice.
#
#   ./say-fast hello world
#   ./say-fast --voice=af_heart "Same words, different canned voice."
#   ./say-fast --file posts/my-post.md
#   ./say-fast --list-voices
#
# Speaks through the warm voice daemon (scripts/voice_daemon.py): the first
# call auto-starts it (one-time model load), every call after that starts
# talking in well under a second. Same flags as before (--voice, --speed,
# --file, --text, --list-voices) plus --stop / --status / --quit.
# Plays through your speakers (ffplay) and saves nothing permanent.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
exec "$HERE/jarvis" "$@"
