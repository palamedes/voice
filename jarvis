#!/usr/bin/env bash
# jarvis — your cloned voice, always loaded: a Breeze TTS 2 server that speaks out loud.
#
#   ./jarvis                          # start the server (loads Breeze, ~25 s) and wait until ready
#   ./jarvis "Good evening, sir."     # speak it (starts the server first if needed)
#   ./jarvis --art-bell               # switch voice; it sticks for later lines
#   ./jarvis --art-bell "Hello, caller."
#   ./jarvis --stop                   # stop talking
#   ./jarvis --status                 # is it up, and in which voice?
#   ./jarvis --quit                   # shut it down (frees ~8 GB of GPU memory)
#
# The server stays up until --quit. A new line interrupts the current one.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
exec "$HERE/breeze-tts/.venv/bin/python" "$HERE/scripts/jarvis_daemon.py" "$@"
