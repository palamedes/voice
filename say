#!/usr/bin/env bash
# say — speak the given text out loud in the cloned voice.
#
#   ./say hello world
#   ./say --muted "Same words, muted voice."
#   ./say --breeze --rate 0.9 "Flags that take values work anywhere."
#   ./say --file posts/my-post.md
#   ./say --list-voices
#
# Everything is passed straight to index_speak.py, which takes the text as plain
# words, --text, or --file. Plays through your speakers (ffplay) and saves
# nothing permanent.
set -euo pipefail

# Resolve the project dir from this script's location, so it works no matter
# what the current working directory is.
HERE="$(cd "$(dirname "$0")" && pwd)"
PY="$HERE/index-tts/.venv/bin/python"
SCRIPT="$HERE/scripts/index_speak.py"

if [ $# -eq 0 ]; then
  echo "usage: say [flags] <text to speak>   (or --file PATH)" >&2
  exit 1
fi

# --list-voices prints to stdout, so it must skip the quiet log below.
for a in "$@"; do
  case "$a" in
    --list-voices) exec "$PY" "$SCRIPT" "$@" ;;
  esac
done

# The model's chatter goes to a log; if something fails, show why instead of staying silent.
log=/tmp/say.log
if ! "$PY" "$SCRIPT" --out /tmp/say.wav --play "$@" >"$log" 2>&1; then
  echo "say: failed; last lines of $log:" >&2
  tail -n 5 "$log" >&2
  exit 1
fi
